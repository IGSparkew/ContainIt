@baseUrl = http://localhost:3000/api

# ============================================================
# INSTANCES
# ============================================================

### List all instances
GET {{baseUrl}}/instances
Content-Type: application/json

###

### Create a PostgreSQL instance
# @name createPostgres
POST {{baseUrl}}/instances
Content-Type: application/json

{
  "name": "pg-dev",
  "type": "postgres",
  "port": 5432,
  "password": "password123",
  "version": "16"
}

###

### Create a MySQL instance
# @name createMysql
POST {{baseUrl}}/instances
Content-Type: application/json

{
  "name": "mysql-dev",
  "type": "mysql",
  "port": 3306,
  "password": "password123",
  "version": "8.0"
}

###

### Create a MongoDB instance
# @name createMongo
POST {{baseUrl}}/instances
Content-Type: application/json

{
  "name": "mongo-dev",
  "type": "mongo",
  "port": 27017,
  "password": "password123",
  "version": "7"
}

###

### Create a Redis instance
# @name createRedis
POST {{baseUrl}}/instances
Content-Type: application/json

{
  "name": "redis-dev",
  "type": "redis",
  "port": 6379,
  "password": "password123",
  "version": "7"
}

###

### Get a single instance by ID
GET {{baseUrl}}/instances/{{createPostgres.response.body.$.id}}
Content-Type: application/json

###

### Start an instance
POST {{baseUrl}}/instances/{{createPostgres.response.body.$.id}}/start
Content-Type: application/json

###

### Stop an instance
POST {{baseUrl}}/instances/{{createPostgres.response.body.$.id}}/stop
Content-Type: application/json

###

### Get instance stats
GET {{baseUrl}}/instances/{{createMysql.response.body.$.id}}/stats
Content-Type: application/json

###

### Delete the PostgreSQL instance
DELETE {{baseUrl}}/instances/{{createPostgres.response.body.$.id}}
Content-Type: application/json

###

### Delete the MySQL instance
DELETE {{baseUrl}}/instances/{{createMysql.response.body.$.id}}
Content-Type: application/json

###

### Delete the MongoDB instance
DELETE {{baseUrl}}/instances/{{createMongo.response.body.$.id}}
Content-Type: application/json

###

### Delete the Redis instance
DELETE {{baseUrl}}/instances/{{createRedis.response.body.$.id}}
Content-Type: application/json

###

# ============================================================
# VOLUMES (orphan volumes)
# ============================================================

### List all orphan volumes
GET {{baseUrl}}/volumes
Content-Type: application/json

###

### Attach an orphan volume to an instance
POST {{baseUrl}}/volumes/my-volume-id/attach
Content-Type: application/json

{
  "instanceId": "{{createPostgres.response.body.$.id}}"
}

###

### Delete an orphan volume
DELETE {{baseUrl}}/volumes/my-volume-id
Content-Type: application/json

###

# ============================================================
# NETWORKS
# ============================================================

### List all networks
GET {{baseUrl}}/networks
Content-Type: application/json

###

### Get a network by ID
GET {{baseUrl}}/networks/my-network-id
Content-Type: application/json

###

### Create a bridge network
# @name createNetwork
POST {{baseUrl}}/networks
Content-Type: application/json

{
  "name": "my-network",
  "driver": "bridge"
}

###

### Create an overlay network
POST {{baseUrl}}/networks
Content-Type: application/json

{
  "name": "my-overlay-network",
  "driver": "overlay"
}

###

### Attach a container to a network
POST {{baseUrl}}/networks/{{createNetwork.response.body.$.id}}/attach
Content-Type: application/json

{
  "containerId": "{{createPostgres.response.body.$.id}}"
}

###

### Detach a container from a network
DELETE {{baseUrl}}/networks/{{createNetwork.response.body.$.id}}/detach/{{createPostgres.response.body.$.id}}
Content-Type: application/json

###

### Delete a network
DELETE {{baseUrl}}/networks/{{createNetwork.response.body.$.id}}
Content-Type: application/json

###
